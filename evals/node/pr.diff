 const express = require('express');
 const fs = require('fs');
 const path = require('path');
 const db = require('../db');
 
 const router = express.Router();
+const TEMPLATE_DIR = path.join(__dirname, '..', 'templates');
 
 router.get('/', async (req, res, next) => {
   try {
     const rows = await db.query('SELECT id, number, total FROM invoices WHERE owner_id = $1 LIMIT 100', [req.user.id]);
     res.json(rows.rows);
   } catch (err) {
     next(err);
   }
 });
 
+router.get('/:id/html', async (req, res) => {
+  const { rows } = await db.query(
+    'SELECT id, number, total, customer_name FROM invoices WHERE id = $1 AND owner_id = $2',
+    [req.params.id, req.user.id],
+  );
+  if (rows.length === 0) {
+    return res.sendStatus(404);
+  }
+  const template = fs.readFileSync(path.join(TEMPLATE_DIR, 'invoice.html'), 'utf8');
+  const html = template
+    .replace('{{number}}', rows[0].number)
+    .replace('{{total}}', rows[0].total)
+    .replace('{{customer}}', rows[0].customer_name);
+  res.type('html').send(html);
+});
+
 module.exports = router;
