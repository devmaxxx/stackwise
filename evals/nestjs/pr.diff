@@ -0,0 +1,25 @@
+import { IsOptional, IsString, MaxLength } from 'class-validator';
+
+export class AddressDto {
+  @IsString()
+  @MaxLength(120)
+  street: string;
+
+  @IsString()
+  @MaxLength(60)
+  city: string;
+
+  @IsString()
+  @MaxLength(12)
+  postcode: string;
+}
+
+export class UpdateProfileDto {
+  @IsOptional()
+  @IsString()
+  @MaxLength(80)
+  displayName?: string;
+
+  @IsOptional()
+  address?: AddressDto;
+}
