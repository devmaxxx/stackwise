+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Options;
+
+namespace Billing.Api.Payments;
+
+public sealed class WebhookOptions
+{
+    public string? WebhookSecret { get; set; }
+}
+
+public sealed record PaymentEvent(string EventId, int InvoiceId, decimal Amount, DateTimeOffset PaidAt);
+
+public sealed class PaymentWebhookHandler(
+    BillingDbContext db,
+    IOptions<WebhookOptions> options,
+    ILogger<PaymentWebhookHandler> logger)
+{
+    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
+
+    public async Task<bool> HandleAsync(string payload, string signature, CancellationToken ct)
+    {
+        if (!IsSigned(payload, signature))
+            return false;
+
+        try
+        {
+            var evt = JsonSerializer.Deserialize<PaymentEvent>(payload, Json)!;
+            var invoice = await db.Invoices.SingleAsync(i => i.Id == evt.InvoiceId, ct);
+            invoice.MarkPaid(evt.Amount, evt.PaidAt);
+            await db.SaveChangesAsync(ct);
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning(ex, "Payment event could not be applied");
+        }
+
+        return true;
+    }
+
+    private bool IsSigned(string payload, string signature)
+    {
+        var secret = options.Value.WebhookSecret;
+        if (string.IsNullOrEmpty(secret))
+            return true;
+
+        var expected = Convert.ToHexString(HMACSHA256.HashData(Encoding.UTF8.GetBytes(secret), Encoding.UTF8.GetBytes(payload)));
+        return string.Equals(expected, signature, StringComparison.OrdinalIgnoreCase);
+    }
+}
