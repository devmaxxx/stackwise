+using System.Collections.Concurrent;
+using Microsoft.EntityFrameworkCore;
+
+namespace Shop.Api.Customers;
+
+public sealed record OrderSummary(int OrderId, decimal Total, int LineCount);
+
+public sealed record CustomerSummary(int CustomerId, IReadOnlyList<OrderSummary> Orders);
+
+public sealed class CustomerSummaryCache
+{
+    private readonly ShopDbContext _db;
+    private readonly ConcurrentDictionary<int, CustomerSummary> _cache = new();
+
+    public CustomerSummaryCache(ShopDbContext db)
+    {
+        _db = db;
+    }
+
+    public async Task<CustomerSummary> GetAsync(int customerId, CancellationToken ct)
+    {
+        if (_cache.TryGetValue(customerId, out var hit))
+            return hit;
+
+        var orders = await _db.Orders
+            .Where(o => o.CustomerId == customerId)
+            .ToListAsync(ct);
+
+        var summaries = new List<OrderSummary>();
+        foreach (var order in orders)
+        {
+            var lines = await _db.OrderLines.Where(l => l.OrderId == order.Id).ToListAsync(ct);
+            summaries.Add(new OrderSummary(order.Id, lines.Sum(l => l.Price * l.Quantity), lines.Count));
+        }
+
+        return _cache[customerId] = new CustomerSummary(customerId, summaries);
+    }
+}
